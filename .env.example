# Nexus Pavilion environment names only. Never commit values.
# Copy to `.env.local` for local Development. Production values stay in the
# host (Vercel) and Supabase dashboards. Do not paste secrets into git,
# tickets, or runbooks.

# --- Public (browser-exposed; must be anon/publishable only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Server-only ---
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=

# Do not configure SUPABASE_SERVICE_ROLE_KEY in the Next.js application.
# Application clients use the anon key plus the signed-in user session.
