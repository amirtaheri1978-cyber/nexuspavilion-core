# Nexus Pavilion environment names only. Never commit values.
# Copy to `.env.local` for local Development. Production values stay in the
# host (Vercel) and Supabase dashboards. Do not paste secrets into git,
# tickets, or runbooks.

# --- Public (browser-exposed; must be anon/publishable only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Server-only ---
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=

# --- Error tracking (optional; app remains fail-open when unset) ---
# Public browser DSN for @sentry/nextjs client instrumentation.
# A DSN is not a private secret, but keep real values out of git.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server/edge DSN override. Falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=

# Do not configure SUPABASE_SERVICE_ROLE_KEY in the Next.js application.
# Application clients use the anon key plus the signed-in user session.
# Do not configure SENTRY_AUTH_TOKEN for Task 15-01 local builds.
# Source-map upload remains disabled in next.config.ts.
